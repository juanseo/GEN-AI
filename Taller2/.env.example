# Copia este archivo como .env (en Taller2/) y completa la key del proveedor que uses.

# LLM por defecto: OpenAI gpt-4o-mini. También habilita los embeddings openai-3-small.
OPENAI_API_KEY=sk-...

# Alternativa: Ollama Cloud con glm-5.3-flash (el modelo del Taller 1)
# ECOMARKET_PROVEEDOR=ollama
# OLLAMA_API_KEY=...

# Opcionales:
# ECOMARKET_EMBEDDINGS=bge-m3       # bge-m3 (defecto) | paraphrase-multilingual | openai-3-small | tfidf
# ECOMARKET_MODELO=gpt-4o-mini      # cualquier modelo del proveedor activo
# ECOMARKET_FECHA=2026-09-22        # "hoy" para el asistente; por defecto, el corte de pedidos.json
# OLLAMA_HOST=http://localhost:11434
