# Copia este archivo como .env y completa la key del proveedor que uses.

# Proveedor por defecto: Ollama Cloud (modelos open-source, https://ollama.com)
OLLAMA_API_KEY=...

# Alternativa: OpenAI (se activa con ECOMARKET_PROVEEDOR=openai)
# OPENAI_API_KEY=sk-...
# OPENAI-API-KEY=sk-...

# Opcionales:
# ECOMARKET_PROVEEDOR=ollama       # ollama (defecto) | openai
# ECOMARKET_MODELO=glm-5.3-flash   # defecto: glm-5.3-flash (ollama) / gpt-4o-mini (openai)
# ECOMARKET_RETRIEVAL=tfidf        # tfidf (offline) | openai (embeddings reales; solo proveedor openai)
# ECOMARKET_MODELO_EMBEDDINGS=text-embedding-3-small
